# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase PostgreSQL Connection String (overrides Cloud SQL if set)
# Use the Transaction/Session Pooler URL from Supabase Project Settings -> Database
DATABASE_URL=""

# Supabase Project URL & API Keys
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional Production Gateway Keys (Ghana SMS, Email, Payments, CAPTCHA)
ARKESEL_API_KEY=""
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
MNOTIFY_API_KEY=""
RESEND_API_KEY=""
PAYSTACK_SECRET_KEY=""
TURNSTILE_SECRET_KEY=""
SESSION_SECRET=""
